# Arquivo de exemplo para variáveis de ambiente
# Renomeie para .env e preencha com seus valores

# Django
DEBUG=True
SECRET_KEY=sua-chave-super-secreta-e-bem-longa-paradevelopment-2026
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de Dados PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=lacrei_saude
DB_USER=postgres
DB_PASSWORD=sua-senha-postgres
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# JWT (se usar djangorestframework-simplejwt)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME=300  # 5 minutos
JWT_REFRESH_TOKEN_LIFETIME=86400  # 1 dia

# Email (opcional, para notificações)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-app

# AWS (se usar para deploy)
AWS_ACCESS_KEY_ID=sua-chave
AWS_SECRET_ACCESS_KEY=sua-secreta
AWS_STORAGE_BUCKET_NAME=seu-bucket

# Logging
LOG_LEVEL=INFO
